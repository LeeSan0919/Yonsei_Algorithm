
def bubble_sort(A):
    n = len(A)
    for i in range(1,n):
        sorted = True
        for j in range(n-1):
            if A[j] > A[j+1]:
                A[j], A[j+1] = A[j+1], A[j]
                sorted = False
        if sorted == True:
            return A


array1 = [69, 10, 30, 2, 16, 8, 31, 22]
print(bubble_sort(array1))