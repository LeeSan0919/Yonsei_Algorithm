
def insertion_sort(A):
    n = len(A)
    for i in range(1, n):
        key = A[i] #Unsorted의 첫 원소
        j = i - 1 # Sorted의 마지막 원소
        while j >= 0 and A[j] > key:
            A[j+1] = A[j]
            j -= 1
        A[j+1] = key

    return A


array1 = [69, 10, 30, 2, 16, 8, 31, 22]
print(insertion_sort(array1))