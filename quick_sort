def partition(A, p, r):
    pivot = A[p]
    L = p + 1
    R = r

    while L <= R:

        while L <= r and A[L] <= pivot:
            L += 1

        while R >= p and A[R] > pivot:
            R -= 1

        if L < R:
            A[L], A[R] = A[R], A[L]

    A[p], A[R] = A[R], A[p]

    return R

def quick_sort(A,p,r):
    if p <r:
        q = partition(A,p,r)
        quick_sort(A,p,q-1) 
        quick_sort(A,q+1,r)


array1 = [69, 10, 30, 2, 16, 8, 31, 22]

print("정렬 전:", array1)

quick_sort(array1, 0, len(array1) - 1)

